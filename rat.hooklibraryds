local isOpen = false
local isTweening = false

local function SetMenuState(state)
    if isTweening then return end
    isTweening = true
    isOpen = state

    if state then
        MainFrame.Visible = true
        ScreenDim.Visible = true
        SnowContainer.Visible = true
        TweenService:Create(ScreenDim, TweenInfo.new(0.3), { BackgroundTransparency = 0.4 }):Play()
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.3), { BackgroundTransparency = 0 })
        t:Play()
        t.Completed:Connect(function() isTweening = false end)
    else
        TweenService:Create(ScreenDim, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
        t:Play()
        t.Completed:Connect(function()
            MainFrame.Visible = false
            ScreenDim.Visible = false
            SnowContainer.Visible = false
            isTweening = false
        end)
    end
end

