local SnowConfig = {
    Words = { "BeeBee", "Rat", "Wallyipe", "rat.hook" },
    MaxWords = 50,
    SpawnInterval = 0.25,
    MinFallTime = 6,
    MaxFallTime = 11,
    MinTextSize = 10,
    MaxTextSize = 14,
}

local function SpawnSnowWord()
    if #activeSnowflakes >= SnowConfig.MaxWords then return end
    local word = SnowConfig.Words[math.random(1, #SnowConfig.Words)]
    local startX = math.random(5, 95) / 100
    local direction = (math.random(0, 1) == 0) and -1 or 1
    local drift = direction * (math.random(80, 240) / 1000)
    local fallTime = math.random(SnowConfig.MinFallTime * 10, SnowConfig.MaxFallTime * 10) / 10

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 100, 0, 18)
    lbl.AnchorPoint = Vector2.new(0.5, 0.5)
    lbl.Position = UDim2.new(startX, 0, -0.04, 0)
    lbl.Rotation = direction * math.random(4, 14)
    lbl.BackgroundTransparency = 1
    lbl.Text = word
    lbl.Font = MainFont
    lbl.TextSize = math.random(SnowConfig.MinTextSize, SnowConfig.MaxTextSize)
    lbl.TextColor3 = Theme.TextMain
    lbl.TextTransparency = 0.7
    lbl.ZIndex = 2
    lbl.Parent = SnowContainer

    table.insert(activeSnowflakes, lbl)

    local endX = math.clamp(startX + drift, -0.05, 1.05)
    local fallTween = TweenService:Create(lbl, TweenInfo.new(fallTime, Enum.EasingStyle.Linear), {
        Position = UDim2.new(endX, 0, 1.05, 0)
    })
    fallTween:Play()

    fallTween.Completed:Connect(function()
        for i, v in ipairs(activeSnowflakes) do
            if v == lbl then
                table.remove(activeSnowflakes, i)
                break
            end
        end
        if lbl then lbl:Destroy() end
    end)
end

task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        if SnowContainer.Visible then
            SpawnSnowWord()
        end
        task.wait(SnowConfig.SpawnInterval)
    end
end)

